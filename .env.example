# Copy to backend/.env and fill in. Never commit the real .env.

# "production" makes the API refuse to start unless DATABASE_URL (Postgres) and the three
# SUPABASE_* settings are set. Vercel deployments count as production automatically.
# APP_ENV=local

# Supabase Postgres connection string (Project Settings → Database → Connect).
# Use the psycopg driver prefix: postgresql+psycopg://
# - On your machine and for migrations: the Session pooler, port 5432.
# - On Vercel: the Transaction pooler, port 6543. Serverless instances open one connection
#   per request, and this pooler shares a few real connections between them.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Supabase project URL and publishable (anon) key: Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Server-only secret key (Project Settings → API keys → Secret keys). Lets the API create
# accounts. Never put it in the frontend or share it.
SUPABASE_SECRET_KEY=<secret-key>

# The Institute's local time zone: what "today" and "this month" mean. Defaults to Europe/Paris.
# INSTITUTE_TIME_ZONE=Europe/Paris

# Audience the API expects in Supabase access tokens. Defaults to Supabase's own value.
# JWT_AUDIENCE=authenticated

# Frontend addresses allowed to call the API from a browser (JSON list).
# Defaults to the local dev server; add the deployed frontend URL in production.
CORS_ORIGINS=["http://localhost:5173"]

# DEBUG, INFO (default), WARNING or ERROR. Logs never include patient data.
# LOG_LEVEL=INFO
