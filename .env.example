# Copy to backend/.env and fill in. Never commit the real .env.

# Supabase Postgres connection string (Project Settings → Database → Session pooler, port 5432).
# Use the psycopg driver prefix: postgresql+psycopg://
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Supabase project URL and publishable (anon) key: Project Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Frontend addresses allowed to call the API from a browser (JSON list).
# Defaults to the local dev server; add the deployed frontend URL in production.
CORS_ORIGINS=["http://localhost:5173"]
